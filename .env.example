ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# init_chat_model string; alternative: google_genai:gemini-2.5-pro
COMMUNITY_MODEL=anthropic:claude-sonnet-5-5
# optional: route model calls through an LLM gateway/proxy (base URL); unset = provider default
COMMUNITY_MODEL_BASE_URL=
LANGSMITH_API_KEY=
# tracing is off by default; set to true (with LANGSMITH_API_KEY) to send traces to LangSmith
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=community-assistant-demo
SUPPORT_CASE_URL=http://127.0.0.1:2025
CUSTOMER_SUCCESS_URL=http://127.0.0.1:2026
# Full A2A endpoint of the Customer Success agent, as its owner documents it; unset = local-dev default
CUSTOMER_SUCCESS_A2A_URL=
# optional: Customer Success agent card URL; unset = <A2A endpoint>/.well-known/agent-card.json
CUSTOMER_SUCCESS_AGENT_CARD_URL=
# optional: API key for the Customer Success A2A endpoint, sent as x-api-key (never defaulted to LANGSMITH_API_KEY)
CUSTOMER_SUCCESS_API_KEY=
